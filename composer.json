{
  "name": "agromate/game", "type": "project", "description": "Agromate private cloud saves", "license": "proprietary",
  "require": {"php": "^8.3", "laravel/framework": "^13.39", "laravel/socialite": "^5.23"},
  "require-dev": {"phpunit/phpunit": "^12.5", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
